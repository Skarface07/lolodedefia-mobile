{
  "expo": {
    "name": "Lɔlɔ̃dedefia Fe Do",
    "slug": "lolodedefia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dzidzofexose.lolodedefia"
    },
    "android": {
      "package": "com.dzidzofexose.lolodedefia",
      "adaptiveIcon": {
        "backgroundColor": "#0F5C33"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F5C33"
        }
      ]
    ]
  }
}